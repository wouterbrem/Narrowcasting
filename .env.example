# Narrowcast Pro Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Chromecast Configuration
# IMPORTANT: For HTML presentations to work on Chromecast, you MUST register a custom receiver
# and set the CHROMECAST_APP_ID environment variable.
#
# Without this, only media files (video, audio, images) will work - HTML presentations will NOT work.
#
# See CHROMECAST_SETUP.md for detailed registration instructions.
#
# CHROMECAST_APP_ID=YOUR_APP_ID_HERE

# Network Configuration
# The server needs to be accessible from Chromecast devices on your network.
# If automatic IP detection doesn't work, manually set your server's IP address:
# SERVER_HOST=192.168.1.100
