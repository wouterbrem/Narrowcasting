{
  "name": "narrowcast-pro",
  "productName": "Narrowcast Pro",
  "version": "2.1.0",
  "description": "Professional multi-Chromecast narrowcasting system with custom branding",
  "main": "electron/main.js",
  "homepage": "./",
  "author": {
    "name": "Narrowcast Pro"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "electron .",
    "electron:dev": "concurrently \"npm run server\" \"wait-on http://localhost:3001 && electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --config.mac.identity=null --config.win.certificateFile=null",
    "dist:mac": "npm run build && electron-builder --mac --config.mac.identity=null",
    "dist:win": "npm run build && electron-builder --win --config.win.certificateFile=null",
    "dist:all": "npm run build && electron-builder -mw --config.mac.identity=null --config.win.certificateFile=null",
    "install-all": "npm install && cd client && npm install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose"
  },
  "build": {
    "appId": "com.narrowcastpro.app",
    "productName": "Narrowcast Pro",
    "copyright": "Copyright © 2024 Narrowcast Pro",
    "electronVersion": "28.0.0",
    "asar": true,
    "compression": "normal",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/build/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "type": "distribution"
    },
    "dmg": {
      "sign": false,
      "title": "${productName} ${version}",
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "iconSize": 120,
      "contents": [
        {
          "x": 150,
          "y": 250,
          "type": "file"
        },
        {
          "x": 390,
          "y": 250,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 400
      }
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "certificateFile": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Narrowcast Pro",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "license": "LICENSE",
      "multiLanguageInstaller": false,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "keywords": [
    "chromecast",
    "narrowcasting",
    "digital-signage",
    "multi-screen"
  ],
  "license": "MIT",
  "dependencies": {
    "bonjour": "^3.5.0",
    "castv2": "^0.1.10",
    "castv2-client": "^1.2.0",
    "cors": "^2.8.5",
    "electron-log": "^5.1.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-updater": "^6.1.8",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "wait-on": "^7.2.0"
  }
}
